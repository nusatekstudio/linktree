---
/**
 * Brand glyphs for the social row. Most are filled marks; Instagram is the
 * stroke-style outline used in the mockup. Decorative — the parent <a> carries
 * the accessible name.
 */
import type { SocialNetwork } from '../data/profile';

interface Props {
  network: SocialNetwork;
  size?: number;
  class?: string;
}

const { network, size, class: className } = Astro.props;

interface Glyph {
  mode: 'fill' | 'stroke';
  size: number;
  body: string;
}

const GLYPHS: Record<SocialNetwork, Glyph> = {
  tiktok: {
    mode: 'fill',
    size: 18,
    body:
      '<path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5.8 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1.84-.1z"/>',
  },
  instagram: {
    mode: 'stroke',
    size: 18,
    body:
      '<rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>',
  },
  x: {
    mode: 'fill',
    size: 16,
    body:
      '<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>',
  },
  threads: {
    mode: 'fill',
    size: 18,
    body:
      '<path d="M17.5 11.5c-.2-.1-.4-.2-.6-.3-.4-3.7-2.4-5.7-5.8-5.7h0c-2 0-3.7.9-4.7 2.4l1.9 1.3c.8-1.1 2-1.3 2.8-1.3h0c1.1 0 1.9.3 2.5.9.4.5.7 1.1.8 1.9-.9-.2-1.9-.2-2.9-.1-2.9.2-4.8 1.9-4.7 4.2.1 1.2.7 2.2 1.7 2.9.8.6 1.9.8 3.1.8.1 0 .2 0 .3 0 1.6-.1 2.8-.7 3.7-1.7.7-.8 1.1-1.9 1.3-3.2.8.5 1.4 1.1 1.7 1.9.5 1.3.6 3.3-1 5-1.4 1.4-3.1 2-5.7 2-2.9 0-5.1-.9-6.5-2.7C3.2 17.9 2.5 15.4 2.5 12s.7-5.9 2.1-7.6c1.4-1.8 3.6-2.7 6.5-2.7 2.9 0 5.1.9 6.6 2.7.7.9 1.3 2 1.6 3.3l2-.5c-.4-1.6-1.1-3-2.1-4.1-1.8-2.2-4.5-3.4-8.1-3.4-3.6 0-6.3 1.2-8.1 3.5C1.4 5.5.5 8.4.5 12s.9 6.5 2.6 8.7c1.8 2.3 4.5 3.5 8.1 3.5 3.2 0 5.5-.8 7.3-2.6 2.4-2.4 2.4-5.4 1.5-7.2-.5-1-1.3-1.9-2.5-2.7zm-5.7 5.7c-1.3.1-2.6-.5-2.7-1.7-.1-.9.6-1.9 2.7-2 .2 0 .5 0 .7 0 .7 0 1.3.1 1.9.2-.2 2.7-1.5 3.4-2.6 3.5z"/>',
  },
};

const g = GLYPHS[network];
const s = size ?? g.size;
---

{
  g.mode === 'stroke' ? (
    <svg
      width={s}
      height={s}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class={className}
      aria-hidden="true"
      focusable="false"
      set:html={g.body}
    />
  ) : (
    <svg
      width={s}
      height={s}
      viewBox="0 0 24 24"
      fill="currentColor"
      class={className}
      aria-hidden="true"
      focusable="false"
      set:html={g.body}
    />
  )
}
